__pycache__/
*.pyc
.env
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.pilot/

# Bulk data — OpenAIP US export (CC-BY-NC-SA; redistribution restricted)
us_apt.json
us_apt.geojson
us_asp.json
us_asp.geojson
us_nav.json
us_nav.geojson
us_nav.cupx
us_obs.json
us_obs.geojson
us_raa.json
us_raa.geojson
us_rca.json
us_rca.geojson
us_hot.json
us_hot.geojson

# Bulk data — Natural Earth shapefile zips (public domain, 73 MB total).
# Converted to GeoJSON via scripts/build_boundaries.py → web/data/ne_*.geojson.
# We commit the derived GeoJSONs (~11 MB total) but keep the zips out.
ne_*.zip

# web/data/airspace.json IS COMMITTED as of 2026-08-09.
#
# It used to be ignored because it was derived from OpenAIP's us_asp.json and
# inherited its CC-BY-NC-SA constraint. It is now built from FAA Class
# Airspace, a work of the US government under 17 U.S.C. 101, so there is no
# licence reason to keep it out and a good reason to keep it in: the APK ships
# it, and a build input that only exists on one machine is not reproducible.
#     py -V:3.13 scripts/fetch_faa_airspace.py

# The retired OpenAIP export, 127 MB. Kept on disk, never committed.
_deprecated/

graphify-out/
.code-review-graph/

# Pre-decimation boundary geojson, kept beside the shipped files so
# scripts/slim_boundaries.py can be re-run at a different tolerance without a
# round trip through the zips. Reproducible: scripts/build_boundaries.py.
web/data/ne_*.full.geojson

# Visual test output. The committed reference frames live in
# scripts/visual_reference/; this is the per-run capture and diff scratch.
scripts/_visual_out/

# ---- Native Android shell ---------------------------------------------------
# The staging bundle and everything Capacitor or Gradle regenerates from it.
# `py -V:3.13 scripts/android_build.py --api-base <url>` rebuilds all of it, so
# committing 168 MB of copies of web/ would be storing the same bytes three
# times: web/, dist/, and android/app/src/main/assets/public/.
dist/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/build/
android/build/
android/.gradle/
android/capacitor-cordova-android-plugins/
# Machine-specific SDK path.
android/local.properties
node_modules/

# Per-run phone captures. Nothing here is a reference frame.
scripts/_phone_out/

# Android upload signing key. The key itself and its passwords.
# Passwords live in the KeePassXC vault, never here.
android/*.jks
android/keystore.properties
