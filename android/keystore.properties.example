# Copy to keystore.properties and fill in. NEVER commit the real one.
#
# The upload key is not the app signing key. With Play App Signing, Google
# holds the key that signs what users install, and this one only proves an
# upload is from you. That means losing it is recoverable: you register a new
# upload key with Play support. Losing the APP signing key would not be.
#
# Generate one with:
#   keytool -genkeypair -v -keystore graticule-upload.jks \
#           -alias graticule-upload -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is resolved relative to the android/ directory.
storeFile=graticule-upload.jks
storePassword=
keyAlias=graticule-upload
keyPassword=
