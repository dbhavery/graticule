<?xml version="1.0" encoding="utf-8"?>
<!-- The pre-Android-12 launch window.

     Capacitor's template pointed the launch theme at a full-screen splash.png
     per density and orientation. A bitmap used directly as a window background
     is STRETCHED to the window, not fitted, so a round mark becomes an ellipse
     on any device whose aspect ratio differs from the asset's, which is most
     of them. A layer-list separates the two jobs: a flat colour fills the
     window, and the mark is a bitmap with center gravity, drawn at its natural
     size and never scaled. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/graticule_splash_bg" />
    <item>
        <bitmap
            android:src="@drawable/splash_logo"
            android:gravity="center" />
    </item>
</layer-list>
