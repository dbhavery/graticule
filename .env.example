# Free, instant: https://aisstream.io — needed for live ship (AIS) positions.
# Without it, the globe still launches with everything else.
AISSTREAM_KEY=

# Free MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/ — needed for the
# wildfires layer (NASA FIRMS active fire detections, VIIRS NOAA-20).
# Without it, the wildfires toggle still appears but stays disabled.
FIRMS_MAP_KEY=

# Optional. If set, Cesium uses ion-hosted high-res terrain & imagery, and the
# OSM Buildings 3D toggle becomes available (extruded building footprints
# globally). Free token at https://ion.cesium.com
CESIUM_ION_TOKEN=

# Optional. If set, the Photoreal 3D toggle becomes available — Google's
# photorealistic 3D Tiles, the full Google Earth mesh including buildings and
# terrain. Free tier with rate limits. Get a key at:
#   https://developers.google.com/maps/documentation/tile/3d-tiles-overview
# Enable the "Map Tiles API" in your Google Cloud project.
GOOGLE_MAPS_API_KEY=

# Optional. OpenSky Network OAuth2 client_credentials (free).
# Register at https://opensky-network.org/, then under your account create an
# API client and download credentials.json. Paste clientId and clientSecret
# below. Without auth the planes feed gets rate-limited to ~5-10 req/min.
# With auth: ~4000 req/day, smooth 6s polling.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Legacy HTTP Basic auth — only for older OpenSky accounts that pre-date the
# OAuth migration. Use the OAuth fields above for any new account.
OPENSKY_USER=
OPENSKY_PASS=
