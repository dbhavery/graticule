# Free, instant: https://aisstream.io — needed for live ship (AIS) positions.
# Without it, the globe still launches with planes only.
AISSTREAM_KEY=

# Optional. If set, Cesium uses ion-hosted high-res terrain & imagery.
# Without it, Vantage falls back to ESRI World Imagery (still looks great).
# Free token at https://ion.cesium.com
CESIUM_ION_TOKEN=
